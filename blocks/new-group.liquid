}
.guarantee-block p {
    font-size: 20px;
    line-height: 20px;
    margin: 0;
}
.guarantee-block p:last-child {
    margin: 8px 0 24px 0;
}
.guarantee-block .content {
    text-align: center;
    padding: 44px 20px;
    border: 1px solid #E82C2A;
    border-radius: 8px;
